# =============================================================================
# Metrica - variaveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# =============================================================================

# --- Banco de dados (Neon ou Supabase) --------------------------------------
# Neon: painel do projeto > Connection string > "Pooled connection"
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/metrica?sslmode=require"

# --- Sessao da aplicacao ----------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Em producao, a URL publica (ex.: https://relatorios.suaempresa.com.br)
NEXTAUTH_URL="http://localhost:3000"

# --- Criptografia dos tokens OAuth em repouso -------------------------------
# CHAVE DIFERENTE do AUTH_SECRET. Se ela for perdida, todas as conexoes
# precisam ser refeitas - guarde uma copia em cofre de senhas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Google (GA4, Google Ads, Search Console, Meu Negocio) ------------------
# console.cloud.google.com > APIs e servicos > Credenciais > ID do cliente OAuth
# Tipo: "Aplicativo da Web"
# URI de redirecionamento autorizado:
#   http://localhost:3000/api/oauth/google/callback
#   https://SEU-DOMINIO/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ads.google.com > Ferramentas > API Center. Nasce com acesso apenas a contas
# de teste; solicite "Basic Access" para ler contas reais.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# O Google descontinua versoes da API a cada ~4 meses. Atualize aqui.
GOOGLE_ADS_API_VERSION="v18"

# --- Meta (Facebook e Instagram Ads) ----------------------------------------
# developers.facebook.com > Meu app > Configuracoes > Basico
# URI de redirecionamento OAuth valido:
#   https://SEU-DOMINIO/api/oauth/meta/callback
# (o Meta exige HTTPS - em dev use um tunel, ex.: ngrok)
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"

# --- Plataformas futuras (deixe vazio ate implementar) ----------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# --- Motor de sincronizacao -------------------------------------------------
# Protege /api/cron/*. O Vercel Cron envia este valor no header Authorization.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
# Quantos dias reprocessar a cada sync. Plataformas de anuncio ajustam numeros
# retroativamente (fraude, conversoes tardias), entao nao basta puxar "ontem".
SYNC_LOOKBACK_DAYS="7"
